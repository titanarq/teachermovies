<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The app is built for Android TV but must also install and run where there is no leanback
         launcher and no touchscreen, so neither feature is required. -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!-- The embedded HTTP server (#66) listens for phones on the LAN. The app only serves HTTP, it
         never makes cleartext requests, so no network security config is needed. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Autostart on TV boot (#126): `BootCompletedReceiver` starts the server and the torrent
         service when the user turned it on in Configuración. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".TeacherMoviesApp"
        android:banner="@drawable/tv_banner"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.TeacherMovies">

        <!-- Two filters: `LEANBACK_LAUNCHER` puts the app on the Android TV home screen, `LAUNCHER`
             on an ordinary launcher, so a phone or tablet build is reachable while developing. -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Exported so the system can deliver `BOOT_COMPLETED`, a protected broadcast no other app
             can send; the receiver ignores every other action. -->
        <receiver
            android:name=".autostart.BootCompletedReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
